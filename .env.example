# --- Cloudflare D1 (system of record) ---
# The database this app reads and writes for every dress/status/cost/note.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
# API token scoped with D1 "Edit" permission (Cloudflare dashboard →
# Manage account → Account API tokens → Create Token → search "D1").
CLOUDFLARE_API_TOKEN=

# --- Auth (Google sign-in via Auth.js v5) ---
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: restrict sign-in to specific email domains, comma-separated.
# Leave unset to allow any Google account to sign in (the access table in D1
# still gates who can actually edit vs. just view).
ALLOWED_EMAIL_DOMAINS=imagine.art,vyro.ai

# --- Google Sheets export (optional, output only) ---
# The sheet is no longer read by the app at all — it's a snapshot you can
# regenerate on demand (the sync button in the header, admins only) from the
# D1 data above. Leave these unset and the sync button will just error;
# nothing else in the app depends on them.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the service account's private key. If you copy it from the downloaded
# JSON key file, keep the \n escape sequences as-is (this app un-escapes them).
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
